# ─────────────────────────────────────────────────────────────
# RentAlert v2 — Environment Variables
# Скопіюй цей файл у .env і заповни значення
# ─────────────────────────────────────────────────────────────

# ─── Telegram ───
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=
# Твій chat_id (для адмін-команд) — від @userinfobot
TELEGRAM_CHAT_ID=

# ─── Turso (база даних) ───
# https://turso.tech → твоя БД → URL (libsql://...)
TURSO_DATABASE_URL=
# Токен доступу до БД
TURSO_AUTH_TOKEN=

# ─── DIM.RIA API ───
# https://developers.ria.com → API key
DIMRIA_API_KEY=

# ─── Admin API ───
# Токен для захисту /api/users і /api/stats
# Згенеруй: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_TOKEN=

# ─── Application ───
PORT=3000
RENDER_EXTERNAL_URL=
LOG_LEVEL=INFO